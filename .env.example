# Local text-chat starting point. Copy to .env; keep credentials out of Git.
# The full integration reference is .env.template.
DEPLOYMENT_MODE=local
BACKEND_CONFIG_FILE=./backend/local-chat-config.yaml
DOCKER_REGISTRY=daedalus-local
DAEDALUS_VERSION=dev

# Use an endpoint and model that support the Responses API and tool calling.
# This is the API root (usually ending in /v1), not the /responses route.
# Inside Docker, localhost means the container, not your host machine.
TOOL_CALLING_LLM_MODEL_BASE_URL=https://your-model-provider.example/v1
TOOL_CALLING_LLM_MODEL_MODEL=your-responses-model
# Optional aliases for backend/tool-calling-config.yaml with a routing gateway.
# The minimal local-chat-config.yaml does not enable model profiles.
# DAEDALUS_LLM_DEEP_MODEL=daedalus/deep
# DAEDALUS_LLM_DEEP_MAX_MODEL=daedalus/max
TOOL_CALLING_LLM_MODEL_API_KEY=

# Generate with: openssl rand -base64 32
SESSION_SECRET=
AUTH_USERNAME=
# bcrypt cost 12 or greater; generate with the README command
AUTH_PASSWORD_HASH=''
AUTH_NAME=

# No external memory or retrieval service is needed for this workflow.
DAEDALUS_MEMORY_MODE=disabled
DAEDALUS_RAG_READINESS_MODE=disabled

# Compose uses local development storage credentials and plaintext HTTP.
NGINX_HTTP_PORT=8080
NEXT_PUBLIC_BASE_URL=http://localhost:8080
