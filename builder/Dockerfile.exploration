# Preserve the exact deployed Python/tool image while replacing the native agent.
FROM rust:1.95.0-slim-bookworm@sha256:d7482085ff5b415f84dba5647ae71606650bdef00db7aeb69f4b3d170c3e4082 AS rust_build
WORKDIR /runtime
COPY runtime/Cargo.toml runtime/Cargo.lock ./
COPY runtime/src ./src
COPY runtime/resources ./resources
COPY runtime/tests ./tests
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/runtime/target,sharing=locked \
    cargo test --locked && cargo build --release --locked && \
    cp target/release/daedalus-runtime /daedalus-runtime
FROM daedalus.ddns.me:5050/btuttle/daedalus@sha256:56a7cffeb1ebd54f51d76aa8afdea4a122cdde9d6abb7395b0e8cdfb608d6f17
COPY --from=rust_build /daedalus-runtime /workspace/daedalus-runtime
COPY daedalus_runtime/exploration.py /workspace/daedalus_runtime/exploration.py
COPY daedalus_runtime/tools.py /workspace/daedalus_runtime/tools.py
COPY runtime/resources/exploration.json /workspace/daedalus_runtime/exploration.json
