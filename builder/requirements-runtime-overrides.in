# NAT 1.9 caps cryptography below 49 even though its runtime code doesn't use
# the binary elliptic-curve APIs removed in cryptography 47. That cap excludes
# the releases fixing CVE-2026-69247 and CVE-2026-69249. Keep this override
# explicit and narrow so lock regeneration can't silently restore a vulnerable
# wheel. The image build exercises NAT's installed ABI and the authentication
# stack through runtime_contract_check.py.
cryptography>=50.0.0,<51

# nv-ingest-client 26.3.0 pins urllib3 2.6.3. Require 2.8 or newer to fix
# CVE-2026-97687 and CVE-2026-97689 as well as the earlier 2.7 fixes.
# The fixed 2.8 API stays inside NAT's declared urllib3<3 compatibility boundary.
# Keep the override paired with the build-time client pipeline contract until
# NV-Ingest widens its dependency.
urllib3>=2.8,<3
