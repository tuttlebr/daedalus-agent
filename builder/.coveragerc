[run]
# Every first-party Python module or package that builder/Dockerfile ships in
# the backend image's /workspace (its build-time *_check.py scripts are removed
# before the runtime stage). The image also ships Python under /skills from the
# skills/ build context, such as skill scripts the briefing renderer runs; this
# list does not measure it. test_ci_makefile_parity enforces this list.
source =
    collection_metadata_api
    document_ingest_api
    entrypoint
    image_api
    daedalus_runtime
    mcp_approval_api
    memory_api
    milvus_collection_migration
    profile_import_api
    agent_skills/src
    autonomous_agent/src
    llm_sandbox/src
    nat_helpers/src
    nat_nv_ingest/src
    perplexity_search/src
    rss_feed/src
    smart_milvus/src
    source_verifier/src
    user_interaction/src
    visual_media/src
    webscrape/src

# Never omit by basename: smart_milvus/register.py is the domain retriever
# that daedalus_runtime.tools.load_tool_factories() loads in production.
omit =
    tests/*
    conftest.py

[report]
skip_empty = True
